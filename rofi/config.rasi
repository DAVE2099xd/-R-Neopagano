configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
}

* {
    font: "JetBrainsMono Nerd Font 14";
    background-color: transparent;
    text-color: #36868f;
}

window {
    width: 600px;
    background-color: #0f052dd9;
    border: 3px solid;
    border-color: #36868f;
    border-radius: 15px;
    padding: 20px;
}

mainbox {
    spacing: 15px;
}

inputbar {
    background-color: #203671;
    border-radius: 10px;
    padding: 10px;
    children: [prompt, entry];
}

prompt {
    text-color: #5fc75d;
    margin: 0 15px 0 5px;
}

entry {
    placeholder: "Buscar aplicación...";
    placeholder-color: #7a88cf;
    text-color: #36868f;
}

listview {
    lines: 7;
    spacing: 5px;
    scrollbar: false;
    border: 0px;
}

element {
    padding: 10px;
    border-radius: 8px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: #36868f;
}

element selected.normal {
    background-color: #5fc75d;
    text-color: #0f052d;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

element-icon {
    size: 28px;
    margin: 0 10px 0 0;
}
